# Copiá este archivo como .env y completá lo que falte.
# Lo que ya está en ~/.env.apihub no hace falta repetirlo: el motor lo lee de ahí.

# ── Meta (Instagram + Facebook) ──────────────────────────────
# Token de PÁGINA de larga duración de @notiviral.oficial.
# La página no está en ninguno de los 8 Business Managers actuales: hay que generarlo.
META_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=

# ── Alojamiento temporal del video ───────────────────────────
# Instagram no acepta el archivo subido directo: necesita una URL pública desde
# donde bajarlo. El mp4 se sube, se publica y se borra en el mismo minuto.
SUPABASE_MEDIA_URL=
SUPABASE_MEDIA_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=videos
